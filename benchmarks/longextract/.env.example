# Set the OpenAI-compatible endpoint to use for benchmark testing, including /v1.
OPENAI_API_BASE=http://127.0.0.1:8000/v1
# Use EMPTY for an endpoint that does not require authentication.
OPENAI_API_KEY=EMPTY
LLM_QUEUE_ENABLED=false
LLM_HTTP_READ_TIMEOUT_S=1800
LLM_BATCH_TIMEOUT_S=7200
MARIE_DEFAULT_MOUNT=/mnt/data/marie-ai
