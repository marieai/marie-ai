# ############### Marie-AI All-in-One Environment Configuration ###############
#
# Copy this file to config/.env and adjust values for your environment.
# All variables have sensible defaults; only override what you need.

# ============================================================
# General
# ============================================================

# Stack name used for deployment identification
STACK_NAME=dev

# Base data directory for all persistent storage (configs, models, etc.)
DATA_DIR=/mnt/data/marie-ai

# ============================================================
# PostgreSQL (DocumentDB)
# ============================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_HOST=marie-psql-server
POSTGRES_PORT=5432

# ============================================================
# MinIO S3 Object Storage
# ============================================================

# Root credentials (admin access)
MINIO_ROOT_USER=marieadmin
MINIO_ROOT_PASSWORD=marietopsecret

# Application credentials (created by mc-setup)
MARIE_ACCESS_KEY=MARIEACCESSKEY
MARIE_SECRET_ACCESS_KEY=MARIESECRETACCESSKEY

# ============================================================
# RabbitMQ Message Broker
# ============================================================

RABBIT_MQ_USERNAME=marie
RABBIT_MQ_PASSWORD=mariepassword
RABBIT_MQ_HOSTNAME=marie-rabbitmq
RABBIT_MQ_PORT=5672

# ============================================================
# ClickHouse Analytics Database
# ============================================================

CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=marie
CLICKHOUSE_ACCESS_MANAGEMENT=1
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_MYSQL_PORT=9004
CLICKHOUSE_MAX_MEMORY=4000000000
CLICKHOUSE_MAX_MEMORY_USER=3000000000
CLICKHOUSE_MEMORY_LIMIT=8G
CLICKHOUSE_MEMORY_RESERVATION=2G

# ============================================================
# HyperDX Observability UI
# ============================================================

HYPERDX_UI_PORT=8080
HYPERDX_API_PORT=8002
HYPERDX_LOG_LEVEL=info
HYPERDX_API_KEY=
HYPERDX_MEMORY_LIMIT=4G
HYPERDX_MEMORY_RESERVATION=1G

# ============================================================
# OpenTelemetry / Log Collector
# ============================================================

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
FLUENTD_PORT=24225
LOG_COLLECTOR_MEMORY_LIMIT=512M
LOG_COLLECTOR_MEMORY_RESERVATION=128M

# ============================================================
# Gitea Git Service
# ============================================================

GITEA_HTTP_PORT=3001
GITEA_SSH_PORT=2222
GITEA_DOMAIN=localhost
GITEA_ROOT_URL=http://localhost:3001
GITEA_DB_NAME=gitea
GITEA_LOG_LEVEL=info
GITEA_INSTALL_LOCK=false
GITEA_DISABLE_REGISTRATION=false
GITEA_REQUIRE_SIGNIN=false
# Generate with: openssl rand -base64 32
GITEA_SECRET_KEY=

# ============================================================
# LiteLLM Proxy Server
# ============================================================

LITELLM_MASTER_KEY=sk-1234
LITELLM_SALT_KEY=sk-1234
# Uncomment to enable database storage:
# LITELLM_DATABASE_URL=postgresql://postgres:123456@marie-psql-server:5432/litellm
# LITELLM_STORE_MODEL_IN_DB=true
LITELLM_LOG=INFO
LITELLM_PORT=4000

# ============================================================
# Marie-AI Gateway
# ============================================================

GATEWAY_IMAGE_TAG=4.0.0-cpu
GATEWAY_CONFIG_TAG=marie-gateway-4.0.0.yml
GATEWAY_LOG_LEVEL=DEBUG

# ============================================================
# Marie-AI Extract Executor (GPU)
# ============================================================

EXTRACT_IMAGE_TAG=4.0.0-cuda
EXTRACT_CONFIG_TAG=marie-extract-4.0.0.yml
EXTRACT_LOG_LEVEL=DEBUG
EXTRACT_STACK_NAME=dev

# ============================================================
# S3 Client Configuration (used by marie-ai application code)
# ============================================================

S3_ACCESS_KEY_ID=MARIEACCESSKEY
S3_SECRET_ACCESS_KEY=MARIESECRETACCESSKEY
S3_ENDPOINT_URL=http://marie-s3-server:8000
S3_BUCKET_NAME=marie
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
