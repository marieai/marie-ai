          "filters": {
            "type": "object",
            "description": "Optional filters to narrow search results"
          }
        },
        "required": ["query"]
      },
      "mockResponse": {
        "results": [
          {"id": "doc_001", "title": "Vendor Agreement", "score": 0.95},
          {"id": "doc_002", "title": "Invoice INV-2024-001", "score": 0.88}
