      "inputSchema": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "description": "Document to classify"
          },
          "categories": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Optional list of categories to consider"
          }
        },
        "required": ["document_id"]
      },
      "mockResponse": {
        "document_id": "doc_12345",
        "primary_category": "invoice",
        "confidence": 0.97,
