{
  "tools": [
    {
      "name": "extract_document",
      "description": "Extract structured data from a document using AI-powered analysis",
      "inputSchema": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "description": "Unique identifier of the document to process"
          },
          "schema": {
            "type": "string",
            "description": "Target extraction schema (e.g., 'invoice', 'receipt', 'contract')"
          },
          "options": {
            "type": "object",
            "properties": {
              "include_confidence": {"type": "boolean", "default": true},
              "extract_tables": {"type": "boolean", "default": true},
              "ocr_enabled": {"type": "boolean", "default": true}
            }
          }
        },
        "required": ["document_id", "schema"]
      },
      "mockResponse": {
        "status": "success",
        "document_id": "doc_12345",
        "extracted_data": {
          "invoice_number": "INV-2024-001",
          "total": 9180.00
        },
        "confidence": 0.95
      }
    },
    {
      "name": "search_knowledge_base",
