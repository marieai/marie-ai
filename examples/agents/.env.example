# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# Marie API Configuration
MARIE_API_URL=http://127.0.0.1:51000/api
MARIE_API_KEY=your-marie-api-key-here
MARIE_QUEUE_ID=0000-0000-0000-0000

# Vision Document Agent
MARIE_VQA_EXECUTOR_URL=http://127.0.0.1:51000/api/vqa

# ---------------------------------------------------------------------------
# Plugin-tool hello-world (agent_plugin_tool_hello_world.py / run_plugin_tool_hello_world.sh)
#   cp .env.example .env     # then fill in the two SIGNING values below
#   ./run_plugin_tool_hello_world.sh
# .env is gitignored; .env.example is committed. All values below are overridable.

# Daemon to talk to (the running one).
MARIE_PLUGIN_DAEMON_URL=http://127.0.0.1:8099

# Tenant the plugin is installed under (daemon tenant = org__workspace).
MARIE_ORG_ID=7909fd70-2651-4c3d-86c8-c313652f63dd
MARIE_WORKSPACE_ID=6fd6dd0f-171a-46ac-9b73-b6d6b9542981

# Installed plugin + the tool to invoke.
MARIE_PLUGIN_PACKAGE_REF=ext.langgenius.jina_tool
MARIE_PLUGIN_PACKAGE_DIGEST=sha256:70c638774b69dae2ab74717c3779de9de7ad8f6c768c227f2b5fce6db4635136
MARIE_PLUGIN_PROVIDER_REF=jina
MARIE_PLUGIN_TOOL_REF=jina_reader

# REQUIRED: the HMAC signing key the daemon + Studio were started with.
# (Leave these out of git — that's what .env is for.)
MARIE_PLUGIN_DAEMON_SIGNING_KEY_ID=A
MARIE_PLUGIN_DAEMON_SIGNING_SECRET=B

# Optional: capture the tool call with DebugCaptureMiddleware into this dir
# (writes tool_calls.jsonl, events.jsonl, debug.txt, run.json + a `latest` symlink).
# MARIE_AGENT_DEBUG_DIR=./.agent-debug

# Optional: a plugin tool's credentials are resolved in marie-ai from the env via
# the secret_ref on the requirement (here env:JINA_API_KEY). jina's api_key is
# optional; set it for a higher rate limit.
# JINA_API_KEY=

